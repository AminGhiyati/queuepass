{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:ensure-admin": "tsx prisma/ensureAdminAccount.ts",
    "db:reset": "prisma db push --force-reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:remove-test-accounts": "tsx prisma/removeTestAccounts.ts",
    "db:move-event-to-the-past": "tsx prisma/moveEventToThePast.ts"
  },
  "exports": {
    "./router": "./src/router/appRouter.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@trpc/server": "^11.18.0",
    "better-auth": "^1.6.26",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^5.1.0",
    "passkit-generator": "^3.5.7",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "stripe": "^22.5.0",
    "superjson": "^2.2.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.10.1",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "node-forge": "^1.4.0",
    "prisma": "^7.9.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
